# Copy to .env.local for development. Every var referenced anywhere in src/ or scripts/
# is listed here — this file is the single source of truth (previously scattered across
# DEPLOYMENT_GUIDE.md, SECURITY_IMPLEMENTATION_GUIDE.md, QUICK_START.md).

# ── Required — app will not start without these ────────────────────────────
MONGODB_URI=
JWT_SECRET=                        # 32+ random chars, e.g. `openssl rand -hex 32`

# ── Admin dashboard (single shared secret today — see Phase 4f for per-admin accounts) ──
ADMIN_SECRET=

# ── Secret encryption at rest (LINE/Telegram/Instagram/SlipOK credentials) ──
# 64 hex chars (32 bytes). Generate with generateEncryptionKey() in src/lib/encryption.ts,
# or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, secrets are stored in plaintext (today's behavior) instead of failing to start.
ENCRYPTION_KEY=

# ── Cron authentication (billing-cycle, trial-expiry, purge, inactivity-check, auto-cancel) ──
CRON_SECRET=

# ── LINE Login channel (merchant dashboard sign-in — separate from each merchant's own
#    Messaging API channel, which they configure themselves in Settings) ──
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_BASE_URL=https://shopenter.app

# ── Shopenter's own LINE Official Account (operational notices to merchants, e.g.
#    inactivity-deletion warnings — distinct from the LINE Login channel above and from
#    each merchant's own storefront channel) ──
SHOPENTER_LINE_CHANNEL_ACCESS_TOKEN=

# ── Omise (merchant subscription billing — Merchant -> Shopenter) ──
OMISE_SECRET_KEY=
NEXT_PUBLIC_OMISE_PUBLIC_KEY=

# ── Cloudflare R2 (media storage — product photos, storefront banners, uploads) ──
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Redis (shared rate limiting across serverless instances — falls back to in-memory,
#    per-instance-only limiting if unset) ──
REDIS_URL=                         # ioredis-compatible URL, e.g. Upstash's TCP endpoint
# UPSTASH_REDIS_URL=               # alias, either name works

# ── Error monitoring ──
NEXT_PUBLIC_SENTRY_DSN=

# ── Upload limits ──
MAX_UPLOAD_MB=4                    # server-side cap; keep under your Vercel plan's request body limit
NEXT_PUBLIC_MAX_UPLOAD_MB=4        # must match MAX_UPLOAD_MB — shown in client-side upload UI

# ── Broadcast (queued sending — see the broadcast-worker cron) ──
# No API exists to detect your Vercel plan automatically, so this is a manual toggle:
# Vercel Hobby only runs crons once/day (a "broadcast" would take up to 24h), so leave this
# false/unset until you're on Pro (or a real always-on queue), where the 5-min cron interval
# in vercel.json actually delivers close to instantly. Both vars must match.
BROADCAST_ENABLED=false
NEXT_PUBLIC_BROADCAST_ENABLED=false

# ── Misc / site config ──
NEXT_PUBLIC_SITE_URL=https://shopenter.app   # used for OpenGraph/sitemap absolute URLs
NEXT_PUBLIC_ALLOW_INDEXING=true              # set to false to noindex non-production deploys

# ── Instagram webhook (per-merchant page tokens live in Settings; these are platform-level) ──
IG_APP_SECRET=
IG_VERIFY_TOKEN=

# ── Dev/seed only ──
# DEFAULT_MERCHANT_ID=              # used by dev seed scripts, not needed in production
# LIFF_ID=                          # legacy/dev fallback; merchants configure their own liffId in Settings
# LINE_CHANNEL_ACCESS_TOKEN=        # legacy/dev fallback; merchants configure their own in Settings
# NEXT_PUBLIC_ADMIN_LINE_ID=        # legacy/dev fallback; merchants configure adminLineId in Settings

# ── Auto-provided by the hosting platform, do not set manually ──
# NODE_ENV
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA
